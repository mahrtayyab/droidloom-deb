diff --git a/graphics/droidloom-wayland/src/decorations.rs b/graphics/droidloom-wayland/src/decorations.rs
new file mode 100644
index 0000000..1c1edf1
--- /dev/null
+++ b/graphics/droidloom-wayland/src/decorations.rs
@@ -0,0 +1,425 @@
+//! Client-side title bars when the compositor cannot provide decorations.
+//!
+//! Frames are separate SHM subsurfaces. Android keeps its original content
+//! origin and direct GPU buffers; clicks on the frame never become Android
+//! touch events. Compositors offering server-side decorations keep that path.
+
+use super::{App, FRACTIONAL_SCALE_DENOMINATOR, PresenterError, TaskObjectId, readiness};
+use droidloom_window_policy::LogicalSize;
+use sctk_adwaita::{AdwaitaFrame, FrameConfig};
+use smithay_client_toolkit::compositor::CompositorState;
+use smithay_client_toolkit::reexports::csd_frame::{
+    DecorationsFrame, FrameAction, FrameClick, ResizeEdge,
+};
+use smithay_client_toolkit::seat::pointer::{
+    CursorIcon, PointerData, PointerEvent, PointerEventKind,
+};
+use smithay_client_toolkit::shell::WaylandSurface;
+use smithay_client_toolkit::shell::xdg::XdgSurface;
+use smithay_client_toolkit::shell::xdg::window::{Window, WindowHandler};
+use smithay_client_toolkit::shm::{Shm, ShmHandler};
+use smithay_client_toolkit::subcompositor::SubcompositorState;
+use std::{num::NonZeroU32, sync::Arc, time::Duration};
+use wayland_client::globals::GlobalList;
+use wayland_client::protocol::wl_pointer;
+use wayland_client::{Connection, Dispatch, Proxy, QueueHandle, WEnum};
+use wayland_protocols::xdg::decoration::zv1::client::zxdg_toplevel_decoration_v1::{
+    self, ZxdgToplevelDecorationV1,
+};
+use wayland_protocols::xdg::shell::client::xdg_toplevel::ResizeEdge as XdgResizeEdge;
+
+pub(super) type Frame = AdwaitaFrame<App>;
+
+pub(super) struct Globals {
+    pub shm: Shm,
+    compositor: Arc<CompositorState>,
+    subcompositor: Arc<SubcompositorState>,
+}
+
+impl Globals {
+    pub fn bind(
+        compositor: Arc<CompositorState>,
+        globals: &GlobalList,
+        qh: &QueueHandle<App>,
+    ) -> Result<Self, PresenterError> {
+        Ok(Self {
+            shm: Shm::bind(globals, qh)?,
+            subcompositor: Arc::new(SubcompositorState::bind(
+                compositor.wl_compositor().clone(),
+                globals,
+                qh,
+            )?),
+            compositor,
+        })
+    }
+
+    fn frame(
+        &self,
+        window: &Window,
+        title: String,
+        qh: &QueueHandle<App>,
+    ) -> Result<Frame, PresenterError> {
+        let mut frame = Frame::new(
+            window,
+            &self.shm,
+            self.compositor.clone(),
+            self.subcompositor.clone(),
+            qh.clone(),
+            FrameConfig::auto(),
+        )
+        .map_err(|error| PresenterError::Decorations(error.to_string()))?;
+        frame.set_title(title);
+        Ok(frame)
+    }
+}
+
+/// XDG configures describe the outside of the window; Android sizes describe
+/// only its content. An unspecified axis must stay unspecified, not shrink
+/// again on activation-only configures. Undersized suggestions stay nonzero.
+pub(super) fn content_dimension(outer: Option<u32>, extra: u32) -> Option<u32> {
+    outer.map(|outer| outer.saturating_sub(extra).max(1))
+}
+
+pub(super) fn content_bounds(outer: LogicalSize, extra: (u32, u32)) -> LogicalSize {
+    LogicalSize {
+        width: outer.width.saturating_sub(extra.0).max(1),
+        height: outer.height.saturating_sub(extra.1).max(1),
+    }
+}
+
+fn resize_edge(edge: ResizeEdge) -> Option<XdgResizeEdge> {
+    Some(match edge {
+        ResizeEdge::Top => XdgResizeEdge::Top,
+        ResizeEdge::Bottom => XdgResizeEdge::Bottom,
+        ResizeEdge::Left => XdgResizeEdge::Left,
+        ResizeEdge::TopLeft => XdgResizeEdge::TopLeft,
+        ResizeEdge::BottomLeft => XdgResizeEdge::BottomLeft,
+        ResizeEdge::Right => XdgResizeEdge::Right,
+        ResizeEdge::TopRight => XdgResizeEdge::TopRight,
+        ResizeEdge::BottomRight => XdgResizeEdge::BottomRight,
+        _ => return None,
+    })
+}
+
+impl App {
+    pub(super) fn set_client_decorations(
+        &mut self,
+        object: TaskObjectId,
+        enabled: bool,
+        qh: &QueueHandle<Self>,
+    ) -> Result<(), PresenterError> {
+        let Some(task) = self.tasks.get_mut(&object) else {
+            return Ok(());
+        };
+        if !task.accepts_present() || enabled == task.client_frame.is_some() {
+            return Ok(());
+        }
+        let window = task.window.as_ref().expect("visible task has a window");
+        if enabled {
+            task.client_frame = Some(self.decoration_globals.frame(
+                window,
+                self.titles.title(&task.package),
+                qh,
+            )?);
+        } else {
+            // Destroy child surfaces before the toplevel, as on task teardown.
+            task.client_frame.take();
+        }
+        let minimum = task
+            .client_frame
+            .as_ref()
+            .map_or((1, 1), |frame| frame.add_borders(120, 1));
+        window.set_min_size(Some(minimum));
+        if let Some((width, height)) = task.logical_size {
+            task.resize.configure(LogicalSize { width, height }, false);
+            self.task_work.mark(object, readiness::RESIZE);
+        }
+        eprintln!(
+            "Droidloom window controls: {} for {}",
+            if enabled {
+                "client-side"
+            } else {
+                "server-side"
+            },
+            task.package
+        );
+        Ok(())
+    }
+
+    pub(super) fn configure_client_frame(
+        &mut self,
+        object: TaskObjectId,
+        size: LogicalSize,
+        scale_120: u32,
+    ) -> Result<(), PresenterError> {
+        let task = self
+            .tasks
+            .get_mut(&object)
+            .ok_or(PresenterError::UnknownTask(object))?;
+        let Some(window) = task.window.as_ref() else {
+            return Ok(());
+        };
+        let (location, outside) = if let Some(frame) = task.client_frame.as_mut() {
+            frame
+                .set_scaling_factor(f64::from(scale_120) / f64::from(FRACTIONAL_SCALE_DENOMINATOR));
+            frame.resize(
+                NonZeroU32::new(size.width)
+                    .ok_or(PresenterError::Configuration("zero frame width"))?,
+                NonZeroU32::new(size.height)
+                    .ok_or(PresenterError::Configuration("zero frame height"))?,
+            );
+            (frame.location(), frame.add_borders(size.width, size.height))
+        } else {
+            ((0, 0), (size.width, size.height))
+        };
+        window.xdg_surface().set_window_geometry(
+            location.0,
+            location.1,
+            i32::try_from(outside.0)
+                .map_err(|_| PresenterError::Configuration("decorated window is too wide"))?,
+            i32::try_from(outside.1)
+                .map_err(|_| PresenterError::Configuration("decorated window is too tall"))?,
+        );
+        Ok(())
+    }
+
+    pub(super) fn draw_client_frames(&mut self) {
+        for task in self.tasks.values_mut() {
+            if !task.accepts_present() || task.logical_size.is_none() {
+                continue;
+            }
+            if let Some(frame) = task.client_frame.as_mut()
+                && frame.is_dirty()
+                && !frame.is_hidden()
+                && frame.draw()
+                && let Some(window) = task.window.as_ref()
+            {
+                // Resize/scale updates synchronize the children with the
+                // parent's viewport and XDG geometry. Hover-only updates are
+                // desynchronized and do not drive Android's rendering loop.
+                window.commit();
+            }
+        }
+    }
+
+    fn frame_cursor(&self, conn: &Connection, cursor: CursorIcon) {
+        if let Some(pointer) = self.themed_pointer.as_ref() {
+            let _ = pointer.set_cursor(conn, cursor);
+        }
+    }
+
+    /// Returns true only for decoration surfaces, consuming all their input.
+    pub(super) fn decoration_pointer_event(
+        &mut self,
+        conn: &Connection,
+        qh: &QueueHandle<Self>,
+        pointer: &wl_pointer::WlPointer,
+        event: &PointerEvent,
+    ) -> bool {
+        let time = match event.kind {
+            PointerEventKind::Motion { time }
+            | PointerEventKind::Press { time, .. }
+            | PointerEventKind::Release { time, .. }
+            | PointerEventKind::Axis { time, .. } => Duration::from_millis(u64::from(time)),
+            _ => Duration::ZERO,
+        };
+        let hit = self.tasks.iter_mut().find_map(|(object, task)| {
+            let frame = task.client_frame.as_mut()?;
+            let cursor = frame.click_point_moved(
+                time,
+                &event.surface.id(),
+                event.position.0,
+                event.position.1,
+            )?;
+            let action = match event.kind {
+                PointerEventKind::Leave { .. } => {
+                    frame.click_point_left();
+                    None
+                }
+                PointerEventKind::Press { button, .. }
+                | PointerEventKind::Release { button, .. } => {
+                    let click = match button {
+                        0x110 => Some(FrameClick::Normal),
+                        0x111 => Some(FrameClick::Alternate),
+                        _ => None,
+                    };
+                    click.and_then(|click| {
+                        frame.on_click(
+                            time,
+                            click,
+                            matches!(event.kind, PointerEventKind::Press { .. }),
+                        )
+                    })
+                }
+                _ => None,
+            };
+            Some((*object, cursor, action))
+        });
+        let Some((object, cursor, action)) = hit else {
+            if matches!(event.kind, PointerEventKind::Enter { .. }) {
+                self.frame_cursor(conn, CursorIcon::Default);
+            }
+            return false;
+        };
+        if matches!(
+            event.kind,
+            PointerEventKind::Enter { .. } | PointerEventKind::Motion { .. }
+        ) {
+            self.frame_cursor(conn, cursor);
+        }
+        if let PointerEventKind::Press { serial, .. } = event.kind
+            && let Some(data) = pointer.data::<PointerData>()
+            && let Some(window) = self.tasks[&object].window.as_ref()
+        {
+            self.activation
+                .input(serial, data.seat(), window.wl_surface());
+            self.clipboard.serial(serial);
+        }
+        if let Some(action) = action {
+            let (PointerEventKind::Press { serial, .. } | PointerEventKind::Release { serial, .. }) =
+                event.kind
+            else {
+                return true;
+            };
+            let Some(window) = self.tasks[&object].window.clone() else {
+                return true;
+            };
+            let Some(data) = pointer.data::<PointerData>() else {
+                return true;
+            };
+            match action {
+                // Use exactly the same task-close transaction as Alt+F4.
+                FrameAction::Close => self.request_close(conn, qh, &window),
+                FrameAction::Minimize => window.set_minimized(),
+                FrameAction::Maximize => window.set_maximized(),
+                FrameAction::UnMaximize => window.unset_maximized(),
+                FrameAction::Move => window.move_(data.seat(), serial),
+                FrameAction::Resize(edge) => {
+                    if let Some(edge) = resize_edge(edge) {
+                        window.resize(data.seat(), serial, edge);
+                    }
+                }
+                FrameAction::ShowMenu(x, y) => {
+                    window.show_window_menu(data.seat(), serial, (x, y));
+                }
+                _ => {}
+            }
+        }
+        true
+    }
+}
+
+impl ShmHandler for App {
+    fn shm_state(&mut self) -> &mut Shm {
+        &mut self.decoration_globals.shm
+    }
+}
+
+impl Dispatch<ZxdgToplevelDecorationV1, TaskObjectId> for App {
+    fn event(
+        state: &mut Self,
+        _proxy: &ZxdgToplevelDecorationV1,
+        event: zxdg_toplevel_decoration_v1::Event,
+        object: &TaskObjectId,
+        _conn: &Connection,
+        qh: &QueueHandle<Self>,
+    ) {
+        let zxdg_toplevel_decoration_v1::Event::Configure {
+            mode: WEnum::Value(mode),
+        } = event
+        else {
+            return;
+        };
+        if let Err(error) = state.set_client_decorations(
+            *object,
+            mode == zxdg_toplevel_decoration_v1::Mode::ClientSide,
+            qh,
+        ) {
+            state.fail(&error);
+        }
+    }
+}
