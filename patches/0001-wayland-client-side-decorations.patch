+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn undecorated_and_fullscreen_sizes_are_unchanged() {
+        assert_eq!(content_dimension(Some(640), 0), Some(640));
+        assert_eq!(
+            content_bounds(
+                LogicalSize {
+                    width: 640,
+                    height: 480
+                },
+                (0, 0)
+            ),
+            LogicalSize {
+                width: 640,
+                height: 480
+            }
+        );
+    }
+
+    #[test]
+    fn titlebar_is_not_included_in_android_content_size() {
+        assert_eq!(content_dimension(Some(480), 35), Some(445));
+        assert_eq!(
+            content_bounds(
+                LogicalSize {
+                    width: 1920,
+                    height: 1080
+                },
+                (0, 35)
+            ),
+            LogicalSize {
+                width: 1920,
+                height: 1045
+            }
+        );
+    }
+
+    #[test]
+    fn activation_only_configures_do_not_shrink_content_again() {
+        assert_eq!(content_dimension(None, 35), None);
+        assert_eq!(content_dimension(Some(640), 0), Some(640));
+    }
+
+    #[test]
+    fn tiny_suggestions_never_create_zero_sized_buffers() {
+        for size in [0, 1, 20, 35] {
+            assert_eq!(content_dimension(Some(size), 35), Some(1));
+        }
+        assert_eq!(
+            content_bounds(
+                LogicalSize {
+                    width: 1,
+                    height: 1
+                },
+                (8, 35)
+            ),
+            LogicalSize {
+                width: 1,
+                height: 1
+            }
+        );
+    }
+
+    #[test]
+    fn all_resize_edges_map_to_the_matching_xdg_request() {
+        for (edge, expected) in [
+            (ResizeEdge::Top, XdgResizeEdge::Top),
+            (ResizeEdge::Bottom, XdgResizeEdge::Bottom),
+            (ResizeEdge::Left, XdgResizeEdge::Left),
+            (ResizeEdge::TopLeft, XdgResizeEdge::TopLeft),
+            (ResizeEdge::BottomLeft, XdgResizeEdge::BottomLeft),
+            (ResizeEdge::Right, XdgResizeEdge::Right),
+            (ResizeEdge::TopRight, XdgResizeEdge::TopRight),
+            (ResizeEdge::BottomRight, XdgResizeEdge::BottomRight),
+        ] {
+            assert_eq!(resize_edge(edge), Some(expected));
+        }
+        assert_eq!(resize_edge(ResizeEdge::None), None);
+    }
+}
